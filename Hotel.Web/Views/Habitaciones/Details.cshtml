@model Habitacion

@{
    ViewData["Title"] = "Detalles de la habitación";
}

<h1>Detalles de la habitación</h1>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">Piso</dt>
    <dd class="col-sm-9">@Model.Piso</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation.Nombre</dd>

    <dt class="col-sm-3">Capacidad</dt>
    <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation.Capacidad persona(s)</dd>

    <dt class="col-sm-3">Precio por noche</dt>
    <dd class="col-sm-9">S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a la lista</a>
</div>
