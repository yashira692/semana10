@model Habitacion

@{
    ViewData["Title"] = "Eliminar habitación";
}

<h1>Eliminar habitación</h1>

<h3 class="text-danger">¿Seguro que quieres eliminar esta habitación?</h3>
<p class="text-muted">La habitación dejará de mostrarse en el sistema, pero sus datos se conservan (eliminación lógica).</p>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">Piso</dt>
    <dd class="col-sm-9">@Model.Piso</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation.Nombre</dd>

    <dt class="col-sm-3">Precio por noche</dt>
    <dd class="col-sm-9">S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdHabitacion" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
